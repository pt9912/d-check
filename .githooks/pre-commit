#!/usr/bin/env bash
# pre-commit-Hook — ADR-Immutable-Gate via Modul vcs (ADR-0024, slice-053).
#
# Verlangt, dass eine Accepted-ADR (docs/plan/adr/NNNN-*.md) nicht inhaltlich
# ueberschrieben wird (AGENTS.md §3.5). Laeuft jetzt ueber das d-check-Modul vcs
# (Image) statt des kopierten Skripts — `make adr-check STAGED=1` baut das Image
# (per Docker-Cache schnell) und prueft den staged-Diff. Installiert via
# `make hooks` (git config core.hooksPath .githooks) — opt-in pro Klon; die
# klon-unabhaengige Kontrolle ist der CI-Range-Check (.github/workflows/ci.yml).
#
# EINE Wahrheit: ruft dasselbe Gate wie CI und `make adr-check` (das Modul vcs).
# Gleiches Gate heisst aber nicht von selbst gleiche Antwort: --staged und
# --range tragen je eine eigene Diff-Uebersetzung. Dass beide auf dieselbe
# Frage dieselbe Antwort geben, ist eine gehaltene Eigenschaft
# (DC-FA-VCS-001), keine, die aus dem gemeinsamen Gate folgt.
# Das abgeloeste Alt-Skript wurde mit ADR-0025 entfernt (codepaths.ignore-refs).
#
# Slice-Closure-Uebergang (Baseline-Regelwerk modul-05 §Lifecycle als State
# Machine): die Vorbedingungen fuer done/ (DoD-Haekchen, Closure-Notiz,
# Risiko-Ausgaenge) haengen am UEBERGANG selbst. Ein gestagter Rename/Add
# eines slice-*.md irgendwo unter docs/plan/planning/done/ -- direkt, unter
# wellenlos/ oder unter <welle-id>/ -- loest zusaetzlich make
# verify-closure-notes aus (SPEC-095). KOPPLUNG: dieselbe Erkennung steht in
# .github/workflows/ci.yml. grep liest die ganze Liste: mit -q braeche es
# beim ersten Treffer ab, und unter pipefail liesse das SIGPIPE des awk
# den Treffer verschwinden. GRENZE: der ausgeloeste Lauf prueft nur die
# Slices direkt unter done/, nicht die in seinen Unterverzeichnissen.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
make adr-check STAGED=1
# Doku-GUARD (seit welle-79): der volle netzlose doc-check bindet den
# Commit an einen gruenen Doku-Stand — ein roter Gate-Exit in einer
# Shell-Kette kann den Commit nicht mehr passieren, weil der Hook selbst
# ihn traegt (set -e). Kostet einen Image-Cache-Lauf (~Sekunden).
make doc-check
if git diff --cached --name-status --diff-filter=AR -- 'docs/plan/planning/done/' \
    | awk -F'\t' '{print $NF}' | grep -E '^docs/plan/planning/done/(.+/)?slice-[0-9]+[^/]*\.md$' > /dev/null; then
    echo "pre-commit: Slice-Closure-Uebergang erkannt -- verify-closure-notes" >&2
    make verify-closure-notes
fi
