#!/usr/bin/env bash
# pre-commit-Hook — ADR-Immutable-Gate (ADR-0016, slice-041).
#
# Verlangt, dass eine Accepted-ADR (docs/plan/adr/NNNN-*.md) nicht inhaltlich
# ueberschrieben wird (AGENTS.md §3.5). Installiert via `make hooks`
# (git config core.hooksPath .githooks) — opt-in pro Klon; die
# klon-unabhaengige Kontrolle ist der CI-Range-Check (.github/workflows/ci.yml).
#
# EINE Wahrheit: ruft dasselbe Skript wie CI und `make adr-check`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec bash tools/adr-immutable-check.sh --staged
